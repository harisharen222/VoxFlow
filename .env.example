# ┌─────────────────────────────────────────────────────┐
# │  VoxFlow — Voice-First AI Knowledge & Workflow Agent │
# │  Copy this file to `.env` and fill in your values.  │
# │  NEVER commit your real .env to version control.    │
# └─────────────────────────────────────────────────────┘

# ── Core AI ──────────────────────────────────────────────────────────────────

# Google Gemini API key (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model to use for RAG + fact extraction
GEMINI_MODEL=gemini-2.5-flash

# ── Voice (Vapi) ──────────────────────────────────────────────────────────────

# Private / backend Vapi key  →  https://dashboard.vapi.ai
VAPI_API_KEY=

# ── Vector DB (Qdrant) ───────────────────────────────────────────────────────

# Cloud cluster host (no https://)  →  https://cloud.qdrant.io
QDRANT_HOST=

# Default port for Qdrant Cloud
QDRANT_PORT=6333

# Qdrant API key (from the cluster dashboard)
QDRANT_API_KEY=

# Name of the Qdrant collection used for the knowledge base
QDRANT_COLLECTION=knowledge_base

# ── Embeddings ────────────────────────────────────────────────────────────────

# Sentence-transformer model (must match the collection dimension)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Public URL (required for Vapi webhooks) ───────────────────────────────────

# Full HTTPS URL where this backend is reachable from the internet.
# Use `ngrok http 8000` and paste the Forwarding URL here.
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# ── Data Connectors (optional) ────────────────────────────────────────────────

# Notion integration token  →  https://www.notion.so/my-integrations
NOTION_TOKEN=

# Google Service Account JSON (single-line)  →  https://console.cloud.google.com
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Server ────────────────────────────────────────────────────────────────────

APP_HOST=0.0.0.0
APP_PORT=8000
